# Postgres (used by docker-compose and the API)
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
POSTGRES_PORT=5432

# Owner connection: migrations and test setup only
DATABASE_URL=postgres://crm:change-me@localhost:5432/crm

# App connection: non-superuser role the API uses so RLS applies (created by pnpm db:migrate).
# Password: at least 16 characters, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
APP_DATABASE_URL=postgres://crm_app:change-me-to-a-long-random-string@localhost:5432/crm

# Auth. JWT_SECRET: at least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me-to-a-long-random-string-of-48-bytes
SESSION_TTL_HOURS=168
# Login/signup attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Set true when running behind a reverse proxy (so rate limiting sees the client IP)
TRUST_PROXY=false
